generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [postgis]
}

// ---------------------------------------------------------------------------
// Enums — identifiers must match DOMAIN.md exactly.
// 'unknown' is derived (source_current_status view), never stored.
// ---------------------------------------------------------------------------

enum SourceType {
  spring
  fountain
  drinking_water
  cistern
  stream
  other

  @@map("source_type")
}

enum ObservationStatus {
  flowing
  low_flow
  dripping
  dry

  @@map("observation_status")
}

enum ReactionType {
  confirm
  dispute

  @@map("reaction_type")
}

// ---------------------------------------------------------------------------
// Water sources (imported from OSM + curated) — see DATABASE.md
// geom is PostGIS; all spatial reads/writes go through lib/db (raw SQL).
// Partial + GiST indexes live in the migration SQL (Prisma can't express them).
// ---------------------------------------------------------------------------

model WaterSource {
  id          String                                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  region      String                                @default("vercors")
  name        String?
  type        SourceType
  geom        Unsupported("geometry(Point, 4326)")
  elevationM  Int?                                  @map("elevation_m")
  osmType     String?                               @map("osm_type")
  osmId       BigInt?                               @map("osm_id")
  isActive    Boolean                               @default(true) @map("is_active")
  createdAt   DateTime                              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime                              @default(now()) @map("updated_at") @db.Timestamptz(6)

  observations Observation[]

  @@unique([osmType, osmId])
  @@map("water_sources")
}

// ---------------------------------------------------------------------------
// Observations (append-only; soft-delete only) — see DATABASE.md
// id is a client-generated UUID (offline idempotency).
// ---------------------------------------------------------------------------

model Observation {
  id         String            @id @db.Uuid
  sourceId   String            @map("source_id") @db.Uuid
  userId     String            @map("user_id")
  status     ObservationStatus
  comment    String?
  photoUrl   String?           @map("photo_url")
  observedAt DateTime          @map("observed_at") @db.Timestamptz(6)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt  DateTime?         @map("deleted_at") @db.Timestamptz(6)

  source    WaterSource           @relation(fields: [sourceId], references: [id])
  user      User                  @relation(fields: [userId], references: [id])
  reactions ObservationReaction[]

  @@map("observations")
}

model ObservationReaction {
  id            String       @id @db.Uuid
  observationId String       @map("observation_id") @db.Uuid
  userId        String       @map("user_id")
  type          ReactionType
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt     DateTime?    @map("deleted_at") @db.Timestamptz(6)

  observation Observation @relation(fields: [observationId], references: [id])
  user        User        @relation(fields: [userId], references: [id])

  @@unique([observationId, userId])
  @@map("observation_reactions")
}

// ---------------------------------------------------------------------------
// Better Auth core tables (user, session, account, verification).
// Owned by Better Auth — verify against `npx @better-auth/cli generate`
// when auth is wired up in Phase 2. `name` is a core column the app never
// reads: there is no public display name (DOMAIN.md § Users & trust).
// ---------------------------------------------------------------------------

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  role          String   @default("user")
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @default(now()) @db.Timestamptz(6)
  // Set when the account was anonymised on request; the row itself stays
  // because observations reference it (lib/db/users.ts).
  deletedAt     DateTime? @map("deleted_at") @db.Timestamptz(6)

  sessions     Session[]
  accounts     Account[]
  observations Observation[]
  reactions    ObservationReaction[]

  @@map("user")
}

model Session {
  id        String   @id
  userId    String
  token     String   @unique
  expiresAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id
  userId                String
  accountId             String
  providerId            String
  accessToken           String?
  refreshToken          String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  idToken               String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime  @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @default(now()) @db.Timestamptz(6)

  @@map("verification")
}
