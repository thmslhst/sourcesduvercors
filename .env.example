# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (with PostGIS enabled).
# Get it from the Neon console or `neon connection-string`.
DATABASE_URL=

# Better Auth (magic-link sessions).
# Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: Resend API key for real magic-link emails.
# Without it (local dev) the link is printed to the server console.
# RESEND_API_KEY=
# EMAIL_FROM="Sources du Vercors <auth@example.org>"

# Optional: alternative Overpass endpoint for the OSM import script.
# OVERPASS_URL=
