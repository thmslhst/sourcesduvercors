{
  "name": "sources-du-vercors",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "NEXT_DIST_DIR=.next-e2e NEXT_PUBLIC_E2E=1 next build && NEXT_DIST_DIR=.next-e2e playwright test",
    "db:migrate": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "import:osm": "tsx scripts/import-osm.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@protomaps/basemaps": "^5.7.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.6.25",
    "maplibre-gl": "^5.24.0",
    "next": "16.2.12",
    "pmtiles": "^4.4.1",
    "prisma": "^6.19.3",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
